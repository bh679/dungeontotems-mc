{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "assets/dungeontotems/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["games.brennan.dungeontotems.fabric.DungeonTotemsFabric"],
    "client": ["games.brennan.dungeontotems.fabric.DungeonTotemsFabricClient"],
    "jade": ["games.brennan.dungeontotems.compat.jade.ZombieJadePlugin"]
  },
  "mixins": [
    "dungeontotems.mixins.json",
    "dungeontotems.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "jade": "*"
  }
}
